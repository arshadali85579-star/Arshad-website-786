@echo off
setlocal EnableDelayedExpansion
chcp 65001 >nul
title Sayyad Arshad Portfolio - Full Project Backup Restore
cls
echo ======================================================================
echo    SAYYAD ARSHAD PORTFOLIO - FULL PROJECT BACKUP RESTORATION
echo ======================================================================
echo.
echo This backup script will restore all 49 project source files, configurations,
echo 3D assets, components, and structure for Sayyad Arshad's Portfolio.
echo.
echo Target Directory: %CD%
echo.
if /i "%1"=="/y" goto :do_restore
if /i "%1"=="-y" goto :do_restore
if /i "%1"=="--yes" goto :do_restore
set "CONFIRM="
set /p "CONFIRM=Proceed with project restoration? (Y/N): "
if /i not "%CONFIRM:~0,1%"=="Y" (
    echo Restoration cancelled by user.
    pause
    exit /b 0
)

:do_restore

echo.
echo [1/2] Rebuilding project directories and files...
echo.

set "BACKUP_BAT_SOURCE=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$scriptFile = $env:BACKUP_BAT_SOURCE; $lines = [System.IO.File]::ReadAllLines($scriptFile, [System.Text.Encoding]::UTF8); $start = $false; $sb = New-Object System.Text.StringBuilder; foreach ($line in $lines) { if ($line.Trim() -eq '__BEGIN_PAYLOAD__') { $start = $true; continue }; if ($start) { [void]$sb.AppendLine($line) } }; $items = ConvertFrom-Json $sb.ToString(); $total = $items.Count; $curr = 0; foreach ($item in $items) { $curr++; $dest = [System.IO.Path]::Combine((Get-Location), $item.path); $parent = [System.IO.Path]::GetDirectoryName($dest); if (-not [System.IO.Directory]::Exists($parent)) { [void][System.IO.Directory]::CreateDirectory($parent) }; $bytes = [System.Convert]::FromBase64String($item.base64); [System.IO.File]::WriteAllBytes($dest, $bytes); Write-Host ('[{0}/{1}] Restored: {2}' -f $curr, $total, $item.path) -ForegroundColor Green }; Write-Host ''; Write-Host '======================================================================' -ForegroundColor Cyan; Write-Host '  SUCCESS! All 49 project files have been restored successfully.' -ForegroundColor Cyan; Write-Host '======================================================================' -ForegroundColor Cyan; Write-Host ''; Write-Host 'Next Steps to Run Project:' -ForegroundColor Yellow; Write-Host '  1. npm install' -ForegroundColor White; Write-Host '  2. npm run dev' -ForegroundColor White; Write-Host '';"

echo.
if /i not "%1"=="/y" if /i not "%1"=="-y" pause
exit /b 0

